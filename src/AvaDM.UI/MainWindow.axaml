<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaDM.UI.ViewModels"
        xmlns:views="using:AvaDM.UI.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="AvaDM.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AvaDM"
        Icon="/Assets/avadm-logo.ico"
        Width="1000" Height="650"
        Background="{DynamicResource BackgroundBrush}">

    <!-- Single window, no persistent app-chrome nav bar (per design.md's Layout section) - just
         swaps the page view model through DataTemplates. Each page's own toolbar carries its
         navigation entry point (Downloads -> Settings gear, Settings -> its own way back). -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:DownloadListViewModel">
            <views:DownloadListView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <ContentControl Content="{Binding CurrentPageViewModel}" />

        <!-- Toasts live at the shell level (not per-page) so an update-available toast from a
             startup check is visible no matter which page is on screen - see
             MainWindowViewModel.Toasts. -->
        <ItemsControl ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="{StaticResource PanelPadding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource SpaceSm}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToastViewModel">
                    <Border Classes="toast">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                            <TextBlock Grid.Column="0" Text="{Binding Message}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{StaticResource BodyMdFontSize}"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="primary"
                                    IsVisible="{Binding HasAction}"
                                    Command="{Binding InvokeActionCommand}"
                                    Content="{Binding ActionLabel}" />
                            <Button Grid.Column="2" Classes="icon"
                                    Command="{Binding DismissCommand}"
                                    ToolTip.Tip="Dismiss">
                                <Path Classes="buttonIcon" Data="{StaticResource CloseGeometry}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>
