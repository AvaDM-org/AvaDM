<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaDM.UI.ViewModels"
             xmlns:controls="using:AvaDM.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="72"
             x:Class="AvaDM.UI.Views.DownloadRowView"
             x:DataType="vm:DownloadRowViewModel">

    <!-- One download row in the file-explorer-style table (issue #19). Full-bleed, 1px bottom
         border, no card - the layout mirrors the column header bar in DownloadListView.axaml so
         the trailing cells line up: [select slot | Name cell | trailing cells]. The Name cell
         holds a fixed-width strip of the 5 action icons (so file names align across rows no
         matter which icons a row shows), then the name, path, and - for an active download only -
         the aggregate progress bar. DoubleTapped opens a completed download (file or folder per
         Settings), ignoring taps on the row's own buttons - see OnHeaderDoubleTapped. -->
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Background="Transparent">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Margin="{StaticResource RowPadding}"
              DoubleTapped="OnHeaderDoubleTapped">

            <!-- Select checkbox slot - wired with multi-select in a later commit. -->
            <Panel Grid.Column="0" Width="28" />

            <Grid Grid.Column="1" ColumnDefinitions="160,*" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center">
                    <Button Classes="icon" Content="&#10074;&#10074;"
                            Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}"
                            ToolTip.Tip="Pause" />
                    <Button Classes="icon" Content="&#9654;"
                            Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}"
                            ToolTip.Tip="Resume" />
                    <Button Classes="icon" Content="&#10005;"
                            Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                            ToolTip.Tip="Cancel" />
                    <Button Classes="icon" Content="&#128193;"
                            Command="{Binding OpenContainingFolderCommand}"
                            ToolTip.Tip="Open containing folder" />
                    <Button Classes="icon" Content="&#128465;"
                            Command="{Binding RemoveCommand}"
                            ToolTip.Tip="Remove" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXs}"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding FileName}"
                               ToolTip.Tip="{Binding FileName}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding DestinationPath}"
                               ToolTip.Tip="{Binding DestinationPath}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource LabelSmFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                 IsIndeterminate="{Binding IsSizeUnknown}"
                                 IsVisible="{Binding ShowProgressBar}" />
                    <TextBlock Text="{Binding LastError}"
                               IsVisible="{Binding HasLastError}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource LabelSmFontSize}"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadCellViewModel">
                        <Border Width="{Binding Column.Width}" Padding="6,0" VerticalAlignment="Stretch">
                            <Panel VerticalAlignment="Center">
                                <StackPanel IsVisible="{Binding !IsStatus}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text}"
                                               ToolTip.Tip="{Binding Text}"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="{StaticResource NumericMdFontSize}"
                                               FontWeight="{StaticResource NumericMdFontWeight}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SubText}"
                                               IsVisible="{Binding HasSubText}"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="{StaticResource LabelSmFontSize}"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                </StackPanel>
                                <controls:StatusChip IsVisible="{Binding IsStatus}"
                                                     StatusClass="{Binding Row.StatusChipClass}"
                                                     StatusText="{Binding Row.StatusText}"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center" />
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
