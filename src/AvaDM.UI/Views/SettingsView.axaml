<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaDM.UI.ViewModels"
             xmlns:controls="using:AvaDM.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AvaDM.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PanelPadding}" Spacing="{StaticResource SpaceMd}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                <TextBlock Grid.Column="0"
                           Text="Settings"
                           FontSize="{StaticResource HeadingLgFontSize}"
                           FontWeight="{StaticResource HeadingLgFontWeight}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                    <HyperlinkButton NavigateUri="https://github.com/AvaDM-org/AvaDM"
                                     ToolTip.Tip="Visit GitHub repository">
                        <Border Background="White"
                                CornerRadius="3"
                                Padding="1">
                            <Image Source="avares://AvaDM.UI/Assets/github-logo.png" Width="25" Height="25" />
                        </Border>
                    </HyperlinkButton>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Downloads &amp; Concurrency"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <StackPanel Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="Download directory"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                            <TextBox Grid.Column="0" Text="{Binding DownloadDirectory, Mode=TwoWay}" />
                            <Button Grid.Column="1" Classes="secondary" Content="Browse..."
                                    Click="OnBrowseDirectoryClick" />
                        </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Chunk count"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding ChunkCount, Mode=TwoWay}"
                                       Minimum="1" Maximum="64" Increment="1"
                                       Width="{StaticResource SettingsNumericFieldWidth}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Max retry attempts"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding MaxRetryAttempts, Mode=TwoWay}"
                                       Minimum="0" Maximum="20" Increment="1"
                                       Width="{StaticResource SettingsNumericFieldWidth}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Retry base delay (seconds)"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding RetryBaseDelaySecondsInput, Mode=TwoWay}"
                                 Width="{StaticResource SettingsNumericFieldWidth}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Per-attempt timeout (seconds)"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding PerAttemptTimeoutSecondsInput, Mode=TwoWay}"
                                 Width="{StaticResource SettingsNumericFieldWidth}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Auto-retry failed downloads"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding AutoRetryAttempts, Mode=TwoWay}"
                                       Minimum="0" Maximum="100" Increment="1"
                                       Width="{StaticResource SettingsNumericFieldWidth}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Speed Limit"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Speed limit"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <controls:SpeedLimitEditor Grid.Column="1"
                                                    SpeedLimitBytesPerSecond="{Binding SpeedLimitBytesPerSecond, Mode=TwoWay}"
                                                    HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Storage"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Repository path"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding RepositoryPathInput, Mode=TwoWay}"
                                 PlaceholderText="{Binding ResolvedRepositoryPathHint}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0" Text="Log files"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding LogDirectoryHint}"
                                              FontSize="{StaticResource BodyMdFontSize}"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="secondary" Content="Open"
                                Command="{Binding OpenLogFolderCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Appearance"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <Panel>
                            <Button Classes="primary" Content="Dark"
                                    Command="{Binding SelectDarkThemeCommand}"
                                    IsVisible="{Binding IsDarkSelected}" />
                            <Button Classes="secondary" Content="Dark"
                                    Command="{Binding SelectDarkThemeCommand}"
                                    IsVisible="{Binding !IsDarkSelected}" />
                        </Panel>
                        <Panel>
                            <Button Classes="primary" Content="Light"
                                    Command="{Binding SelectLightThemeCommand}"
                                    IsVisible="{Binding IsLightSelected}" />
                            <Button Classes="secondary" Content="Light"
                                    Command="{Binding SelectLightThemeCommand}"
                                    IsVisible="{Binding !IsLightSelected}" />
                        </Panel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Downloaded Item Double-Click"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="What should double-clicking a completed download do?"
                               FontSize="{StaticResource BodyMdFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <Panel>
                            <Button Classes="primary" Content="Open File"
                                    Command="{Binding SelectDoubleClickOpenFileCommand}"
                                    IsVisible="{Binding IsDoubleClickOpenFileSelected}" />
                            <Button Classes="secondary" Content="Open File"
                                    Command="{Binding SelectDoubleClickOpenFileCommand}"
                                    IsVisible="{Binding !IsDoubleClickOpenFileSelected}" />
                        </Panel>
                        <Panel>
                            <Button Classes="primary" Content="Open Containing Folder"
                                    Command="{Binding SelectDoubleClickOpenContainingFolderCommand}"
                                    IsVisible="{Binding IsDoubleClickOpenContainingFolderSelected}" />
                            <Button Classes="secondary" Content="Open Containing Folder"
                                    Command="{Binding SelectDoubleClickOpenContainingFolderCommand}"
                                    IsVisible="{Binding !IsDoubleClickOpenContainingFolderSelected}" />
                        </Panel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Window Closing"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <Panel>
                            <Button Classes="primary" Content="Minimize to Tray"
                                    Command="{Binding SelectCloseToTrayCommand}"
                                    IsVisible="{Binding IsCloseToTraySelected}" />
                            <Button Classes="secondary" Content="Minimize to Tray"
                                    Command="{Binding SelectCloseToTrayCommand}"
                                    IsVisible="{Binding !IsCloseToTraySelected}" />
                        </Panel>
                        <Panel>
                            <Button Classes="primary" Content="Close App"
                                    Command="{Binding SelectCloseAppCommand}"
                                    IsVisible="{Binding IsCloseAppSelected}" />
                            <Button Classes="secondary" Content="Close App"
                                    Command="{Binding SelectCloseAppCommand}"
                                    IsVisible="{Binding !IsCloseAppSelected}" />
                        </Panel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Startup"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Launch AvaDM automatically when you log in? It starts minimized to the tray."
                               FontSize="{StaticResource BodyMdFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <Panel>
                            <Button Classes="primary" Content="Start with System"
                                    Command="{Binding SelectStartWithSystemEnabledCommand}"
                                    IsVisible="{Binding IsStartWithSystemEnabledSelected}" />
                            <Button Classes="secondary" Content="Start with System"
                                    Command="{Binding SelectStartWithSystemEnabledCommand}"
                                    IsVisible="{Binding !IsStartWithSystemEnabledSelected}" />
                        </Panel>
                        <Panel>
                            <Button Classes="primary" Content="Don't Start with System"
                                    Command="{Binding SelectStartWithSystemDisabledCommand}"
                                    IsVisible="{Binding IsStartWithSystemDisabledSelected}" />
                            <Button Classes="secondary" Content="Don't Start with System"
                                    Command="{Binding SelectStartWithSystemDisabledCommand}"
                                    IsVisible="{Binding !IsStartWithSystemDisabledSelected}" />
                        </Panel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Updates"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Check for a newer AvaDM version automatically when the app starts?"
                               FontSize="{StaticResource BodyMdFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <Panel>
                            <Button Classes="primary" Content="Check Automatically"
                                    Command="{Binding SelectAutoUpdateEnabledCommand}"
                                    IsVisible="{Binding IsAutoUpdateEnabledSelected}" />
                            <Button Classes="secondary" Content="Check Automatically"
                                    Command="{Binding SelectAutoUpdateEnabledCommand}"
                                    IsVisible="{Binding !IsAutoUpdateEnabledSelected}" />
                        </Panel>
                        <Panel>
                            <Button Classes="primary" Content="Don't Check Automatically"
                                    Command="{Binding SelectAutoUpdateDisabledCommand}"
                                    IsVisible="{Binding IsAutoUpdateDisabledSelected}" />
                            <Button Classes="secondary" Content="Don't Check Automatically"
                                    Command="{Binding SelectAutoUpdateDisabledCommand}"
                                    IsVisible="{Binding !IsAutoUpdateDisabledSelected}" />
                        </Panel>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentVersion, StringFormat='Version {0}'}"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding UpdateStatusMessage}"
                                   IsVisible="{Binding HasUpdateStatusMessage}"
                                   FontSize="{StaticResource BodyMdFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="secondary" Content="Check for Updates"
                                Command="{Binding CheckForUpdatesCommand}" />
                        <Button Grid.Column="3" Classes="primary" Content="Update Now"
                                Command="{Binding InstallUpdateCommand}"
                                IsVisible="{Binding IsUpdateAvailable}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="{StaticResource PanelPadding}"
                    IsVisible="{Binding ShowDesktopShortcutSection}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="Desktop Shortcut"
                               FontSize="{StaticResource HeadingSmFontSize}"
                               FontWeight="{StaticResource HeadingSmFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Add AvaDM to your applications menu."
                               FontSize="{StaticResource BodyMdFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                        <Panel>
                            <Button Classes="primary" Content="Add to Applications Menu"
                                    Command="{Binding CreateDesktopShortcutCommand}"
                                    IsVisible="{Binding IsDesktopShortcutCreatedSelected}" />
                            <Button Classes="secondary" Content="Add to Applications Menu"
                                    Command="{Binding CreateDesktopShortcutCommand}"
                                    IsVisible="{Binding !IsDesktopShortcutCreatedSelected}" />
                        </Panel>
                        <Panel>
                            <Button Classes="primary" Content="Remove Shortcut"
                                    Command="{Binding RemoveDesktopShortcutCommand}"
                                    IsVisible="{Binding IsDesktopShortcutRemovedSelected}" />
                            <Button Classes="secondary" Content="Remove Shortcut"
                                    Command="{Binding RemoveDesktopShortcutCommand}"
                                    IsVisible="{Binding !IsDesktopShortcutRemovedSelected}" />
                        </Panel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       FontSize="{StaticResource BodyMdFontSize}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       FontSize="{StaticResource BodyMdFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource SpaceSm}">
                <Button Classes="secondary" Content="Back to Downloads"
                        Command="{Binding CloseSettingsCommand}" />
                <Button Classes="primary" Content="Save Settings"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
