<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaDM.UI.ViewModels"
             xmlns:views="using:AvaDM.UI.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AvaDM.UI.Views.DownloadListView"
             x:DataType="vm:DownloadListViewModel">

    <UserControl.Resources>
        <!-- Checkable column entries for the header context menu's "Show columns" submenu -
             one per column, checked = visible, disabled for the pinned Name column. -->
        <ControlTheme x:Key="ColumnToggleItemTheme" TargetType="MenuItem"
                      x:DataType="vm:DownloadColumnViewModel"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="ToggleType" Value="CheckBox" />
            <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
            <Setter Property="IsEnabled" Value="{Binding CanHide}" />
            <Setter Property="StaysOpenOnClick" Value="True" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Full-bleed table rows: no item padding/rounding, a flat surface-alt hover, and the
             primary-tinted SelectionBrush for a selected row (issue #19). -->
        <Style Selector="ListBox.downloads">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.downloads ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.downloads ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="ListBox.downloads ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        </Style>
        <Style Selector="ListBox.downloads ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        </Style>

        <!-- Column-resize grip on the right edge of each header cell. -->
        <Style Selector="Thumb.colGrip">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" HorizontalAlignment="Stretch">
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Right" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.colGrip:pointerover /template/ Rectangle">
            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Two-bar toolbar + columned table (docs/design.md; issue #19). Bar 1: search, the
         advanced-add "+" button, and the settings gear (the quick-add link box and the
         multi-select trash land here in later commits). Bar 2: the sortable column header,
         built from DownloadColumnsViewModel so a sort/reorder/show-hide reflows the rows below. -->
    <Panel>
        <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{StaticResource ToolbarPadding}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="{StaticResource SpaceSm}">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="Search downloads..." />

                    <Button Grid.Column="1"
                            Classes="icon"
                            Content="&#65291;"
                            FontSize="{StaticResource HeadingSmFontSize}"
                            Command="{Binding AddDownloadCommand}"
                            ToolTip.Tip="Add download (advanced)" />

                    <Button Grid.Column="2"
                            Classes="icon"
                            Content="&#128465;"
                            FontSize="{StaticResource HeadingSmFontSize}"
                            IsVisible="{Binding HasSelection}"
                            Command="{Binding BulkRemoveCommand}"
                            ToolTip.Tip="Remove selected downloads" />

                    <Button Grid.Column="3"
                            Classes="icon"
                            Content="&#9881;"
                            FontSize="{StaticResource HeadingSmFontSize}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Settings" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{StaticResource RowPadding}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox Grid.Column="0" Width="28"
                              IsThreeState="False"
                              IsChecked="{Binding SelectAllState, Mode=TwoWay}"
                              ToolTip.Tip="Select all"
                              VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <Button Grid.Column="1"
                            Classes="columnHeader"
                            DataContext="{Binding Columns.NameColumn}"
                            Command="{Binding SortCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                            <TextBlock Text="{Binding Header}" />
                            <TextBlock Text="{Binding SortGlyph}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}" IsEnabled="{Binding CanReorder}" />
                                <MenuItem Header="Move right" Command="{Binding MoveRightCommand}" IsEnabled="{Binding CanReorder}" />
                                <Separator />
                                <MenuItem Header="Show columns"
                                          ItemsSource="{Binding Owner.Columns}"
                                          ItemContainerTheme="{StaticResource ColumnToggleItemTheme}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <ItemsControl Grid.Column="2" x:Name="TrailingHeaders"
                                  ItemsSource="{Binding Columns.VisibleTrailingColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadColumnViewModel">
                                <Grid Width="{Binding Width}" ColumnDefinitions="*,Auto"
                                      Background="Transparent"
                                      PointerPressed="OnHeaderPointerPressed"
                                      PointerMoved="OnHeaderPointerMoved"
                                      PointerReleased="OnHeaderPointerReleased">
                                    <Button Grid.Column="0" Classes="columnHeader"
                                            Command="{Binding SortCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SortGlyph}" />
                                        </StackPanel>
                                    </Button>
                                    <Thumb Grid.Column="1" Classes="colGrip"
                                           DragDelta="OnHeaderGripDragDelta" />
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}" IsEnabled="{Binding CanReorder}" />
                                            <MenuItem Header="Move right" Command="{Binding MoveRightCommand}" IsEnabled="{Binding CanReorder}" />
                                            <Separator />
                                            <MenuItem Header="Show columns"
                                                      ItemsSource="{Binding Owner.Columns}"
                                                      ItemContainerTheme="{StaticResource ColumnToggleItemTheme}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <ListBox Grid.Row="2"
                     Classes="downloads"
                     ItemsSource="{Binding FilteredDownloads}"
                     SelectedItems="{Binding SelectedDownloads}"
                     SelectionMode="Multiple">
                <ListBox.KeyBindings>
                    <KeyBinding Gesture="Delete" Command="{Binding BulkRemoveCommand}" />
                </ListBox.KeyBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadRowViewModel">
                        <views:DownloadRowView />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border IsVisible="{Binding IsAddDownloadOpen}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:AddDownloadView DataContext="{Binding ActiveAddDownload}" />
            </Border>
        </Border>

        <Border IsVisible="{Binding IsRemoveConfirmationOpen}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:RemoveConfirmationView DataContext="{Binding ActiveRemoveConfirmation}" />
            </Border>
        </Border>

        <Border IsVisible="{Binding IsCancelConfirmationOpen}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:CancelConfirmationView DataContext="{Binding ActiveCancelConfirmation}" />
            </Border>
        </Border>

        <Border IsVisible="{Binding IsBulkRemoveConfirmationOpen}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:BulkRemoveConfirmationView DataContext="{Binding ActiveBulkRemoveConfirmation}" />
            </Border>
        </Border>

        <ItemsControl ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="{StaticResource PanelPadding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource SpaceSm}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastViewModel">
                    <Border Classes="toast">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                            <TextBlock Grid.Column="0" Text="{Binding Message}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{StaticResource BodyMdFontSize}"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Content="&#10005;"
                                    Command="{Binding DismissCommand}"
                                    ToolTip.Tip="Dismiss" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>